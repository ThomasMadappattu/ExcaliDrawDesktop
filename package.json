{
  "name": "excalidraw-desktop",
  "version": "0.2.0",
  "description": "Offline Electron desktop version of Excalidraw",
  "author": "ThomasMadappattu",
  "license": "MIT",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "node scripts/fetch-libraries.mjs && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "libraries": "node scripts/fetch-libraries.mjs --force"
  },
  "build": {
    "appId": "com.thomasmadappattu.excalidrawdesktop",
    "productName": "Excalidraw Desktop",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!build/afterPack.js"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Excalidraw Drawing",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "publish": null,
    "afterPack": "build/afterPack.js"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0",
    "wait-on": "^8.0.1"
  }
}